# Copy to .env.prod and fill in. Never commit .env.prod or the GitHub App key.
SITE_ADDRESS=repopilot.example.com
POSTGRES_PASSWORD=change-me-long-random
REDIS_PASSWORD=change-me-long-random

# From the GitHub App (see docs/pilot.md)
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_KEY_FILE=./deploy/github-app.pem

# Optional: named API tokens for scripts, e.g. ci:long-random-token
API_TOKENS=
REQUIRE_SEPARATE_REVIEWER=false

# Ports (defaults shown). Postgres and Redis listen on 127.0.0.1 only, for the host worker.
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_PORT=5434
REDIS_PORT=6381
